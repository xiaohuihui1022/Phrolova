# ── Cloudflare 凭据（Drizzle远程迁移使用） ──
# Cloudflare Account ID（从 Cloudflare Dashboard → 右上角 "获取账户信息" 查看）
CLOUDFLARE_ACCOUNT_ID=
# D1 Database ID (wrangler d1 create phrolova-db 后获得）
CLOUDFLARE_DATABASE_ID=
# Cloudflare API Token (D1 编辑权限 - wrangler d1 通常使用
CLOUDFLARE_D1_TOKEN=

# ── Cloudflare Pages / Workers Secrets（通过 wrangler secret put 设置，勿在此处填明文） ──
# SECRET_KEY: 用于管理登录 Token 签名及密码哈希（替换为随机长字符串）
# wrangler secret put SECRET_KEY
# ADMIN_PASSWORD: 管理后台密码
# wrangler secret put ADMIN_PASSWORD

# ── 前端开发代理（可选） ──
# VITE_API_BASE=/api
# VITE_API_PROXY_TARGET=http://127.0.0.1:5174
