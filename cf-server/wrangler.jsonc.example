{
  "name": "phrolova-multiplayer",
  "main": "index.ts",
  "compatibility_date": "2025-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v2-sqlite",
      "new_sqlite_classes": ["RoomObject", "MatchmakerObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phrolova-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "../drizzle",
      "migrations_table": "drizzle_migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomObject" },
      { "name": "MATCHMAKER", "class_name": "MatchmakerObject" }
    ]
  },
  "services": [],
  "vars": {
    "ADMIN_USER": "admin",
    "SESSION_TTL": "7200",
    "CAPTCHA_TTL": "180"
  }
}
