{
  "name": "phrolova",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phrolova-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle",
      "migrations_table": "drizzle_migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomObject",
        "script_name": "phrolova-multiplayer"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "MatchmakerObject",
        "script_name": "phrolova-multiplayer"
      }
    ]
  },
  "vars": {
    "ADMIN_USER": "admin",
    "SESSION_TTL": "7200",
    "CAPTCHA_TTL": "180"
  },
  "//": "UPSTASH_REDIS_URL 和 UPSTASH_REDIS_TOKEN 用于在线人数统计，请用 wrangler secret put 设置（不要明文写在 vars 中）"
}
